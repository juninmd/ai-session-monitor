{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Session Monitor",
  "identifier": "dev.aisessionmonitor.tray",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node src-tauri/scripts/prepare-sidecar.mjs --release && pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "flyout",
        "title": "AI Session Monitor",
        "width": 432,
        "height": 720,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBMkRCMDQ1MTIyNkFDNTUKUldSVnJDWVNSYkF0S2xrenNrMURuYnpOck9LbkcybmlRQmRmYWswVEpaQkEvMEx2TXVDMldRdTMK",
      "endpoints": [
        "https://github.com/juninmd/ai-session-monitor/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/statusline-shim"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR", "English"] }
    }
  }
}
